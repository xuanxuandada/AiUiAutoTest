# Midscene.js Runner 环境变量配置（模板文件，不含任何真实密钥）

# 端口号（config.js 依赖它，必须保留）
PORT=3001

# ============ 任务并发控制 ============
# 同时执行的测试任务上限。默认 1 = 完全串行（推荐）。
# 每个任务都会开一个 Chromium 并持续调 AI，调大容易打满内存/CPU，
# 也会让云厂商（阿里云百炼等）的并发配额瞬间报 429。
# 机器配置好、且云厂商配额充足时可改为 2 或 3；
# 不配或填非法值（空/0/负数）都会自动回退为 1。
MAX_CONCURRENT_TASKS=1

# ============ 报告/截图存储目录 ============
# 测试报告(HTML)与截图(PNG)分开存放在 G:\aitest 下的两个子目录，
# 必须与后端 application.yml 的 app.artifact.report-dir / screenshot-dir 一致。
BACKEND_REPORT_DIR=G:/aitest/reports
BACKEND_SCREENSHOT_DIR=G:/aitest/screenshots

# ============ Midscene AI 配置（平台运行时不需要配） ============
# 说明：每个登录用户的 API Key 存在数据库里，由 Java 后端按登录身份下发到
#      /execute 请求体中，Runner 通过 modelConfig 传给 Agent（isolatedMode）。
#      系统【不提供全局兜底 Key】，所以下面这几项默认全部注释掉。
#      只有临时直连 Runner 调试时才需要，且不要写真实 Key 到文件里。
#
# 注意：键名必须是 MIDSCENE_MODEL_* 这一组（Midscene 1.10 的约定），
#       四个名字写错任何一个都会导致读取不到配置。
#
# MIDSCENE_MODEL_NAME=qwen-vl-max
# MIDSCENE_MODEL_FAMILY=qwen2.5-vl
# MIDSCENE_MODEL_API_KEY=
# MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
